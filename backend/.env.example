# TigerGraph Savanna: workspace URL like https://<id>.i.tgcloud.io (Connect page)
SAVANNA_HOST=
SAVANNA_USERNAME=
SAVANNA_PASSWORD=
# Optional: GSQL secret instead of username/password
SAVANNA_SECRET=
SAVANNA_GRAPH=FraudGraph

# Mistral (https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-14b-latest

# Folder holding transactions.csv, identity.csv, closed_cases_history.csv, case_pack.csv, README.md
DATA_DIR=/path/to/dataset
