// FraudGraph schema: README's suggested schema plus InvestigationCase (our case memory).
// If FraudGraph already exists on Savanna, run `DROP GRAPH FraudGraph` first or apply as a schema change job.
CREATE VERTEX Customer (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX Card (PRIMARY_ID id STRING, network STRING, card_type STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX Transaction (PRIMARY_ID id STRING, TransactionAmt DOUBLE, ProductCD STRING, card4 STRING, card6 STRING,
  addr1 DOUBLE, addr2 DOUBLE, dist1 DOUBLE, P_emaildomain STRING, R_emaildomain STRING, M4 STRING, M6 STRING,
  customer_id STRING, ts DATETIME, channel STRING, risk_score DOUBLE, card_id STRING, device STRING,
  device_specific BOOL, DeviceType STRING, id_15 STRING, id_23 STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX DeviceProfile (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX EmailDomain (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX BillingRegion (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX ClosedCase (PRIMARY_ID id STRING, customer_id STRING, card_id STRING, opened_at STRING, closed_at STRING,
  outcome STRING, pattern STRING, first_fraud_txn_id STRING, n_txns INT, exposure_usd DOUBLE, actions_taken STRING,
  report_filed STRING, analyst_notes STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX InvestigationCase (PRIMARY_ID id STRING, hhg_id STRING, status STRING, verdict STRING, pattern STRING,
  fraud_probability DOUBLE, exposure_usd DOUBLE, summary STRING, answer_json STRING) WITH primary_id_as_attribute="true"

CREATE DIRECTED EDGE OWNS (FROM Customer, TO Card) WITH REVERSE_EDGE="OWNED_BY"
CREATE DIRECTED EDGE MADE (FROM Card, TO Transaction) WITH REVERSE_EDGE="MADE_BY"
CREATE DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile) WITH REVERSE_EDGE="DEVICE_OF"
CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain) WITH REVERSE_EDGE="EMAIL_OF"
CREATE DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion) WITH REVERSE_EDGE="REGION_OF"
CREATE DIRECTED EDGE INVOLVES (FROM ClosedCase, TO Transaction) WITH REVERSE_EDGE="INVOLVED_IN"
CREATE DIRECTED EDGE ON_CARD (FROM ClosedCase, TO Card) WITH REVERSE_EDGE="CARD_CASE"
CREATE DIRECTED EDGE CONNECTED_TO (FROM ClosedCase, TO Card) WITH REVERSE_EDGE="CONNECTED_CASE"
CREATE DIRECTED EDGE INVESTIGATES (FROM InvestigationCase, TO Card) WITH REVERSE_EDGE="INVESTIGATED_BY"
CREATE DIRECTED EDGE AFFECTS (FROM InvestigationCase, TO Transaction) WITH REVERSE_EDGE="AFFECTED_BY"
CREATE DIRECTED EDGE SIMILAR_TO (FROM InvestigationCase, TO ClosedCase) WITH REVERSE_EDGE="SIMILAR_OF"
CREATE DIRECTED EDGE CONNECTS (FROM InvestigationCase, TO Card) WITH REVERSE_EDGE="CONNECTED_BY"

CREATE GRAPH FraudGraph (*)
