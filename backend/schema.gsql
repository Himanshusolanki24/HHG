CREATE VERTEX Customer (
    id STRING PRIMARY KEY,
    label STRING,
    risk FLOAT,
    segment STRING,
    opened DATE,
    stated_income STRING,
    vulnerability_flag BOOL,
    attrs STRING
) WITH DISTRIBUTED_BY(id);

CREATE VERTEX Account (
    id STRING PRIMARY KEY,
    label STRING,
    risk FLOAT,
    status STRING,
    segment STRING,
    balance STRING,
    attrs STRING
) WITH DISTRIBUTED_BY(id);

CREATE VERTEX Card (
    id STRING PRIMARY KEY,
    label STRING,
    risk FLOAT,
    network STRING,
    status STRING,
    last_cp_use DATE,
    issuer STRING,
    attrs STRING
) WITH DISTRIBUTED_BY(id);

CREATE VERTEX Transaction (
    id STRING PRIMARY KEY,
    at DATETIME,
    amount FLOAT,
    merchant STRING,
    direction STRING,
    flagged BOOL,
    attrs STRING
) WITH DISTRIBUTED_BY(id);

CREATE VERTEX Device (
    id STRING PRIMARY KEY,
    label STRING,
    risk FLOAT,
    fingerprint STRING,
    first_seen DATETIME,
    os STRING,
    accounts_bound INT,
    attrs STRING
) WITH DISTRIBUTED_BY(id);

CREATE VERTEX IP (
    id STRING PRIMARY KEY,
    label STRING,
    risk FLOAT,
    asn STRING,
    tor_exit BOOL,
    geo STRING,
    attrs STRING
) WITH DISTRIBUTED_BY(id);

CREATE VERTEX Email (
    id STRING PRIMARY KEY,
    label STRING,
    risk FLOAT,
    verified BOOL,
    age_days INT,
    attrs STRING
) WITH DISTRIBUTED_BY(id);

CREATE VERTEX Case (
    id STRING PRIMARY KEY,
    title STRING,
    trigger STRING,
    pattern STRING,
    risk FLOAT,
    confidence FLOAT,
    status STRING,
    alert_at DATETIME,
    closed DATE,
    outcome STRING,
    analyst_note STRING,
    embedding FLOAT_VECTOR(1536)
) WITH DISTRIBUTED_BY(id);

CREATE VERTEX Evidence (
    id STRING PRIMARY KEY,
    kind STRING,
    label STRING,
    summary STRING,
    source STRING,
    embedding FLOAT_VECTOR(1536)
) WITH DISTRIBUTED_BY(id);

CREATE VERTEX FraudPattern (
    id STRING PRIMARY KEY,
    name STRING,
    description STRING,
    indicators STRING,
    embedding FLOAT_VECTOR(1536)
) WITH DISTRIBUTED_BY(id);

CREATE VERTEX PolicyClause (
    id STRING PRIMARY KEY,
    doc STRING,
    clause STRING,
    title STRING,
    text STRING,
    embedding FLOAT_VECTOR(1536)
) WITH DISTRIBUTED_BY(id);

CREATE UNDIRECTED EDGE performed (FROM Account, TO Transaction) WITH REVERSE_LWH("weight")(
    weight FLOAT
);

CREATE UNDIRECTED EDGE used_device (FROM Account, TO Device) WITH REVERSE_LWH("weight")(
    weight FLOAT
);

CREATE UNDIRECTED EDGE shares_email (FROM Account, TO Email) WITH REVERSE_LWH("weight")(
    weight FLOAT
);

CREATE UNDIRECTED EDGE transfers_to (FROM Account, TO Account) WITH REVERSE_LWH("weight")(
    weight FLOAT
);

CREATE UNDIRECTED EDGE linked_case (FROM Account, TO Case) WITH REVERSE_LWH("weight")(
    weight FLOAT
);

CREATE UNDIRECTED EDGE matched_pattern (FROM Case, TO FraudPattern) WITH REVERSE_LWH("weight")(
    weight FLOAT
);

CREATE UNDIRECTED EDGE CHARGED (FROM Card, TO Transaction) WITH REVERSE_LWH("weight")(
    weight FLOAT
);

CREATE UNDIRECTED EDGE FROM_DEVICE (FROM Transaction, TO Device) WITH REVERSE_LWH("weight")(
    weight FLOAT
);

CREATE UNDIRECTED EDGE CONNECTED_FROM (FROM Device, TO IP) WITH REVERSE_LWH("weight")(
    weight FLOAT
);

CREATE UNDIRECTED EDGE SEEN_WITH (FROM IP, TO Card) WITH REVERSE_LWH("weight")(
    weight FLOAT
);

CREATE UNDIRECTED EDGE SUBJECT_OF (FROM Account, TO Case) WITH REVERSE_LWH("weight")(
    weight FLOAT
);

CREATE UNDIRECTED EDGE USES (FROM Account, TO Device) WITH REVERSE_LWH("weight")(
    weight FLOAT
);

CREATE UNDIRECTED EDGE HAS_CARD (FROM Account, TO Card) WITH REVERSE_LWH("weight")(
    weight FLOAT
);

CREATE UNDIRECTED EDGE HAS_EMAIL (FROM Account, TO Email) WITH REVERSE_LWH("weight")(
    weight FLOAT
);

CREATE UNDIRECTED EDGE BOUND_TO (FROM Device, TO Account) WITH REVERSE_LWH("weight")(
    weight FLOAT
);

CREATE UNDIRECTED EDGE RECEIVED_BY (FROM Transaction, TO Account) WITH REVERSE_LWH("weight")(
    weight FLOAT
);

CREATE UNDIRECTED EDGE ADDED_PAYEE (FROM Account, TO Account) WITH REVERSE_LWH("weight")(
    weight FLOAT
);

CREATE UNDIRECTED EDGE SENT (FROM Account, TO Transaction) WITH REVERSE_LWH("weight")(
    weight FLOAT
);

CREATE GRAPH FraudGraph (Customer, Account, Card, Transaction, Device, IP, Email, Case, Evidence, FraudPattern, PolicyClause,
    performed, used_device, shares_email, transfers_to, linked_case, matched_pattern,
    CHARGED, FROM_DEVICE, CONNECTED_FROM, SEEN_WITH, SUBJECT_OF, USES, HAS_CARD,
    HAS_EMAIL, BOUND_TO, RECEIVED_BY, ADDED_PAYEE, SENT);